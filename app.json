{
  "expo": {
    "name": "UMINIKTA",
    "slug": "uminikta",
    "version": "1.0.0",
    "scheme": "uminikta",
    "orientation": "portrait",
    "icon": "./assets/uminikta-app-icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.cce.uminikta",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/uminikta-app-icon-1024.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon-64x64.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "47e4efec-a4a7-4033-a1bd-6089f3f38b4b"
      }
    },
    "owner": "itskensec"
  }
}
