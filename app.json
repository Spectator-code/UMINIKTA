{
  "expo": {
    "name": "uminikta",
    "slug": "uminikta",
    "version": "1.0.0",
    "scheme": "uminikta",
    "orientation": "portrait",
    "icon": "./assets/uminikta-app-icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/uminikta-app-icon-1024.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon-64x64.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store"
    ]
  }
}
